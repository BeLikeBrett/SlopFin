<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProsperoToolDirectory Condition="'$(ProsperoToolDirectory)' == ''">$(MSBuildThisFileDirectory)../../../build/ultrapack-tool</ProsperoToolDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LibProsperoPkg">
      <HintPath>$(ProsperoToolDirectory)/LibProsperoPkg.dll</HintPath>
    </Reference>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
  </ItemGroup>
</Project>
